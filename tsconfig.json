{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
